# Copy to .env and fill in. NEVER commit .env.
SM_USER=you@example.com
SM_PASS=your-password

# Base32 TOTP seed captured during MFA re-enrollment (Security -> Reset MFA ->
# "enter key manually"). Required for unattended login. Keep it secret.
SM_TOTP_SECRET=JBSWY3DPEHPK3PXP

# Entry point
SM_LOGIN_URL=https://authx.siteminder.com/login

# A URL glob that only matches once login fully succeeds (the app landing page).
SM_SUCCESS_URL_GLOB=https://platform.siteminder.com/**

# Where to save the authenticated session (cookies + storage).
SM_STATE_FILE=state/storageState.json

# Your SiteMinder property id (spid), from the dashboard URL.
SM_SPID=00000000-0000-0000-0000-000000000000

# How many days ahead to pull (defaults to 365 if unset).
SM_DAYS=365

# Run the browser visibly for debugging (true/false).
SM_HEADFUL=false

# Device trust handling:
#   skip   = log in as an untrusted, session-only device (default)
#   manual = pause on the "trusted device" screen until you click the link in
#            SiteMinder's email (up to SM_TRUST_WAIT_MS, default 5 min)
SM_DEVICE_TRUST=skip

# Zalo Bot API — https://bot.zapps.me (create a bot, get the token; chat_id is the
# group/user id). Endpoint: https://bot-api.zaloplatforms.com/bot<TOKEN>/sendMessage
ZALO_BOT_TOKEN=12345689:abc-xyz
ZALO_CHAT_ID=your-group-or-user-id

# Persistent SiteMinder browser profile (keep it OUTSIDE the repo). Needed to reveal guest
# emails: the trusted-device key lives in this profile. Trust it once with:
#   SM_DEVICE_TRUST=manual node src/auth.js   (then click the link in SiteMinder's email)
SM_PROFILE_DIR=C:\laluna\sm-profile

# Cancellation feedback emails to Booking.com guests (cancellationEmail.txt).
#   off | dry-run (default: reveal + build, don't send) | live
GUEST_EMAIL_MODE=dry-run
# Gmail sending (SMTP + App Password). The sending account needs 2-Step Verification;
# create the password at https://myaccount.google.com/apppasswords
#   Test: node src/gmailSend.js --test you@example.com
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
GMAIL_FROM="Laluna Hoi An Riverside Hotel & Spa <you@gmail.com>"
